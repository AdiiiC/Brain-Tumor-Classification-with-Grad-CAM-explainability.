# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated API keys. Leave unset for local dev to disable auth.
# ALWAYS set this in any deployed environment.
API_KEYS=

# Comma-separated CORS origins. Never use "*" with credentials enabled.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

RATE_LIMIT_ENABLED=true

# ── Models ────────────────────────────────────────────────────────────────────
# auto  → Keras when importable, otherwise ONNX
# keras → full features including Grad-CAM++ and SHAP
# onnx  → slim runtime, classification only (explainability returns 400)
MODEL_BACKEND=auto

MODEL_PATH=model_best.keras
TFLITE_PATH=brain_tumor_model.tflite
ONNX_PATH=brain_tumor_model.onnx
UNET_PATH=unet_segmentation.keras

MODEL_VERSION=efficientnetb1-v1
# Temperature scaling from post-training calibration.
CALIBRATION_TEMP=1.5
UNCERTAINTY_FLAG_THRESHOLD=0.05

# ── Out-of-distribution detection ─────────────────────────────────────────────
# Generate with: python -m scripts.fit_ood --data-dir <training-set>
OOD_STATS_PATH=ood_stats.npz
OOD_MAHALANOBIS_THRESHOLD=120.0
OOD_ENERGY_THRESHOLD=-5.0

# ── Persistence ───────────────────────────────────────────────────────────────
PERSIST_RESULTS=true
DATABASE_URL=sqlite:///./brainscan.db
# Production example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/brainscan

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set automatically on Render; override locally if git is unavailable.
# GIT_SHA=
